#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_DEL";
            bindings = <&kp BSPC>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        LFT_MML: LFT_MML {
            compatible = "zmk,behavior-mod-morph";
            label = "LFT_MML";
            bindings = <&kp LEFT_ARROW>, <&mmv MOVE_LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        RGHT_MMR: RGHT_MMR {
            compatible = "zmk,behavior-mod-morph";
            label = "RGHT_MMR";
            bindings = <&kp RIGHT_ARROW>, <&mmv MOVE_RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        UP_MMU: UP_MMU {
            compatible = "zmk,behavior-mod-morph";
            label = "UP_MMU";
            bindings = <&kp UP_ARROW>, <&mmv MOVE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        DOWN_MMD: DOWN_MMD {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWN_MMD";
            bindings = <&kp DOWN_ARROW>, <&mmv MOVE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        MAGIC_TAP: MAGIC_TAP {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            quick-tap-ms = <350>;
            require-prior-idle-ms = <350>;
        };

        HMR_LEFT_TAP: HMR_LEFT_TAP {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_LEFT_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <350>;
            require-prior-idle-ms = <350>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        HMR_RIGHT_TAP: HMR_RIGHT_TAP {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_RIGHT_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <350>;
            require-prior-idle-ms = <350>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        MY_ALLCAPS: MY_ALLCAPS {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_ALLCAPS";
            bindings = <&caps_word>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            quick-tap-ms = <350>;
            require-prior-idle-ms = <350>;
            hold-trigger-key-positions = <1 2 3 4 5 13 14 15 16 17 25 26 27 28 29 6 7 8 9 10 18 19 20 21 22 30 31>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base_0 {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&gresc   &kp Q                 &kp W                     &kp E                         &kp R                       &kp T              &kp Y  &kp U                         &kp I                   &kp O                  &kp P                  &bspc_del
&kp TAB  &HMR_LEFT_TAP LCMD A  &HMR_LEFT_TAP LEFT_ALT S  &HMR_LEFT_TAP LEFT_CONTROL D  &HMR_LEFT_TAP LEFT_SHIFT F  &MY_ALLCAPS 0 G    &kp H  &HMR_RIGHT_TAP RIGHT_SHIFT J  &HMR_RIGHT_TAP RCTRL K  &HMR_RIGHT_TAP RALT L  &HMR_RIGHT_TAP RCMD I  &kp RET
&to 2    &kp Z                 &kp X                     &kp C                         &kp V                       &kp B              &kp N  &kp M                         &kp COMMA               &kp DOT                &kp FSLH               &kp SQT
                                                         &kp LEFT_GUI                  &kp SPACE                   &mo 1              &mo 1  &kp SPACE                     &kp RIGHT_GUI
            >;
        };

        MediaNums {
            display-name = "MediaNums";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &bt BT_SEL 0          &bt BT_SEL 1       &bt BT_SEL 2      &bt BT_SEL 3     &bt BT_SEL 4    &kp PG_UP      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_DIVIDE    &kp KP_SUBTRACT
&bt BT_CLR  &kp C_REWIND          &kp C_FF           &kp C_PLAY_PAUSE  &kp C_MUTE       &kp MINUS       &kp PAGE_DOWN  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_MULTIPLY  &kp PLUS
&kp LSHFT   &kp C_AL_SCREENSAVER  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp PRINTSCREEN  &kp EQUAL       &kp HOME       &kp N7        &kp N8        &kp N9        &kp N0           &kp KP_EQUAL
                                                     &kp LGUI          &kp SPACE        &kp LSHFT       &kp END        &kp RET       &kp RALT
            >;

            label = "MediaNums";
        };

        Mouse {
            bindings = <
&trans  &kp C_AC_COPY   &trans            &kp LSHFT      &kp C_AC_UNDO     &kp C_AC_ZOOM_IN     &trans     &msc SCRL_UP    &RGHT_MMR  &trans          &trans           &trans
&to 1   &kp C_AC_PASTE  &kp C_AC_REFRESH  &kp C_AC_BACK  &kp C_AC_FORWARD  &kp C_AC_FIND        &LFT_MML   &UP_MMU         &DOWN_MMD  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans
&to 0   &kp C_AC_CUT    &trans            &trans         &kp C_AC_REDO     &kp C_AC_ZOOM_OUT    &trans     &msc SCRL_DOWN  &trans     &trans          &trans           &trans
                                          &trans         &trans            &kp RSHFT            &mkp MCLK  &mkp LCLK       &mkp RCLK
            >;

            label = "Mouse";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
